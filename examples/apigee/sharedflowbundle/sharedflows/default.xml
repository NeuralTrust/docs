<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  TrustGuard evaluate - one shared flow for both directions.
  Direction: FlowCallout <Parameter name="trustguard.direction">input|output</Parameter>,
  otherwise (flow hooks) from whether a target response exists yet: before = input, after = output.
  Each direction is evaluated once per transaction (hooks + FlowCallouts on one proxy are safe).
-->
<SharedFlow name="default">
    <Step>
        <Name>KVM-TrustGuard-GetApiKey</Name>
    </Step>
    <Step>
        <Name>JS-TrustGuard-BuildRequest</Name>
    </Step>
    <Step>
        <Name>RF-TrustGuard-StreamRejected</Name>
        <Condition>trustguard.action = "reject_stream"</Condition>
    </Step>
    <Step>
        <Name>AM-TrustGuard-EvaluateRequest</Name>
        <Condition>trustguard.skip != "true"</Condition>
    </Step>
    <Step>
        <Name>SC-TrustGuard-Evaluate</Name>
        <Condition>trustguard.skip != "true"</Condition>
    </Step>
    <Step>
        <Name>JS-TrustGuard-ApplyVerdict</Name>
        <Condition>trustguard.skip != "true"</Condition>
    </Step>
    <Step>
        <Name>RF-TrustGuard-Block</Name>
        <Condition>trustguard.action = "block"</Condition>
    </Step>
    <Step>
        <Name>RF-TrustGuard-Unavailable</Name>
        <Condition>trustguard.action = "fail_closed"</Condition>
    </Step>
</SharedFlow>
