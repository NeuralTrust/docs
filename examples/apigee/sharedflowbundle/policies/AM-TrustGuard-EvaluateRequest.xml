<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Builds a NEW request message for the callout; the client's request is not touched. -->
<AssignMessage name="AM-TrustGuard-EvaluateRequest" continueOnError="false" enabled="true">
    <DisplayName>AM-TrustGuard-EvaluateRequest</DisplayName>
    <AssignTo createNew="true" transport="http" type="request">trustguard.evaluateRequest</AssignTo>
    <Set>
        <Headers>
            <Header name="Authorization">Bearer {private.trustguard.api_key}</Header>
            <Header name="X-Request-Id">{messageid}</Header>
        </Headers>
        <Payload contentType="application/json">{trustguard.evaluate.body}</Payload>
        <Verb>POST</Verb>
    </Set>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
</AssignMessage>
