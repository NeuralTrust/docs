<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Collector key (tgk_...) from the encrypted environment KVM "trustguard". The private. prefix hides it in Debug. -->
<KeyValueMapOperations name="KVM-TrustGuard-GetApiKey" mapIdentifier="trustguard" continueOnError="true" enabled="true">
    <DisplayName>KVM-TrustGuard-GetApiKey</DisplayName>
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <Get assignTo="private.trustguard.api_key">
        <Key>
            <Parameter>api_key</Parameter>
        </Key>
    </Get>
</KeyValueMapOperations>
