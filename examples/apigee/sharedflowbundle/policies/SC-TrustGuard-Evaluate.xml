<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  continueOnError="true": a timeout, connection error or non-2xx answer does not fault here;
  JS-TrustGuard-ApplyVerdict reads servicecallout.SC-TrustGuard-Evaluate.failed and the status
  code and applies fail_mode (closed = 503, open = forward).
  Timeout: keep it above TrustGuard's p99 for your policy and below the client's own timeout.
-->
<ServiceCallout name="SC-TrustGuard-Evaluate" continueOnError="true" enabled="true" async="false">
    <DisplayName>SC-TrustGuard-Evaluate</DisplayName>
    <Request clearPayload="false" variable="trustguard.evaluateRequest"/>
    <Response>trustguard.evaluateResponse</Response>
    <Timeout>10000</Timeout>
    <HTTPTargetConnection>
        <URL>https://{propertyset.trustguard.host}/v1/evaluate</URL>
        <!-- Strict TLS: fail on invalid, expired, self-signed or mismatched certificates.
             Self-hosted TrustGuard with a private or chart-generated CA: import the CA into an
             environment truststore and add <TrustStore>ref://trustguard-truststore</TrustStore>. -->
        <SSLInfo>
            <Enabled>true</Enabled>
            <Enforce>true</Enforce>
        </SSLInfo>
        <Properties>
            <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
        </Properties>
    </HTTPTargetConnection>
</ServiceCallout>
