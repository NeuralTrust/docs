<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- OpenAI-style error body so SDK clients surface a readable message. -->
<RaiseFault name="RF-TrustGuard-Block" continueOnError="false" enabled="true">
    <DisplayName>RF-TrustGuard-Block</DisplayName>
    <FaultResponse>
        <Set>
            <StatusCode>403</StatusCode>
            <ReasonPhrase>Forbidden</ReasonPhrase>
            <Headers>
                <Header name="X-TrustGuard-Status">block</Header>
                <Header name="X-TrustGuard-Trace-Id">{trustguard.trace_id}</Header>
            </Headers>
            <Payload contentType="application/json" variablePrefix="@" variableSuffix="#">{"error":{"type":"trustguard_blocked","code":"content_blocked","message":"The @trustguard.blocked_side# was blocked by the organization's AI security policy.","trace_id":"@trustguard.trace_id#"}}</Payload>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
