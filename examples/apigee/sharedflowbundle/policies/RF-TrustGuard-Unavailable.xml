<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- fail_mode=closed: TrustGuard could not be reached or answered with an error. -->
<RaiseFault name="RF-TrustGuard-Unavailable" continueOnError="false" enabled="true">
    <DisplayName>RF-TrustGuard-Unavailable</DisplayName>
    <FaultResponse>
        <Set>
            <StatusCode>503</StatusCode>
            <ReasonPhrase>Service Unavailable</ReasonPhrase>
            <Headers>
                <Header name="Retry-After">{trustguard.retry_after}</Header>
                <Header name="X-TrustGuard-Status">unavailable</Header>
            </Headers>
            <Payload contentType="application/json" variablePrefix="@" variableSuffix="#">{"error":{"type":"trustguard_unavailable","code":"security_check_unavailable","message":"The AI security check could not be completed. Retry later.","reason":"@trustguard.failure_reason#"}}</Payload>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
