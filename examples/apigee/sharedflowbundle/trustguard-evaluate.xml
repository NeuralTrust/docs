<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<SharedFlowBundle revision="1" name="trustguard-evaluate">
    <DisplayName>trustguard-evaluate</DisplayName>
    <Description>NeuralTrust TrustGuard: evaluate an LLM or MCP request (input) or response (output) with POST /v1/evaluate and enforce the verdict.</Description>
    <Policies>
        <Policy>KVM-TrustGuard-GetApiKey</Policy>
        <Policy>JS-TrustGuard-BuildRequest</Policy>
        <Policy>AM-TrustGuard-EvaluateRequest</Policy>
        <Policy>SC-TrustGuard-Evaluate</Policy>
        <Policy>JS-TrustGuard-ApplyVerdict</Policy>
        <Policy>RF-TrustGuard-Block</Policy>
        <Policy>RF-TrustGuard-Unavailable</Policy>
        <Policy>RF-TrustGuard-StreamRejected</Policy>
    </Policies>
    <Resources>
        <Resource>jsc://tg-common.js</Resource>
        <Resource>jsc://tg-build-request.js</Resource>
        <Resource>jsc://tg-apply-verdict.js</Resource>
    </Resources>
    <SharedFlows>
        <SharedFlow>default</SharedFlow>
    </SharedFlows>
    <subType>SharedFlow</subType>
</SharedFlowBundle>
