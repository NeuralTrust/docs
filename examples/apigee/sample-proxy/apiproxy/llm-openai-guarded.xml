<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="llm-openai-guarded">
    <DisplayName>llm-openai-guarded</DisplayName>
    <Description>Sample: OpenAI-compatible proxy protected by the trustguard-evaluate shared flow (per-proxy attachment).</Description>
    <BasePaths>/llm/openai</BasePaths>
    <Policies>
        <Policy>VJ-VerifyAccessToken</Policy>
        <Policy>AM-TrustGuard-Context</Policy>
        <Policy>FC-TrustGuard-Input</Policy>
        <Policy>FC-TrustGuard-Output</Policy>
        <Policy>KVM-Provider-GetKey</Policy>
        <Policy>AM-Provider-Auth</Policy>
        <Policy>AM-TrustGuard-DebugHeaders</Policy>
    </Policies>
    <ProxyEndpoints>
        <ProxyEndpoint>default</ProxyEndpoint>
    </ProxyEndpoints>
    <TargetEndpoints>
        <TargetEndpoint>openai</TargetEndpoint>
    </TargetEndpoints>
</APIProxy>
