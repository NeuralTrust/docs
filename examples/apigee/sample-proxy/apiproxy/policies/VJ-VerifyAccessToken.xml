<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Replace issuer, audience and JWKS with your IdP (Entra ID, Okta, Ping, ...). -->
<VerifyJWT name="VJ-VerifyAccessToken" continueOnError="false" enabled="true">
    <DisplayName>VJ-VerifyAccessToken</DisplayName>
    <Algorithm>RS256</Algorithm>
    <Source>request.header.authorization</Source>
    <PublicKey>
        <JWKS uri="https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys"/>
    </PublicKey>
    <Issuer>https://login.microsoftonline.com/TENANT_ID/v2.0</Issuer>
    <Audience>api://llm-gateway</Audience>
    <TimeAllowance>30s</TimeAllowance>
</VerifyJWT>
