<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Contract with the shared flow (all optional):
    trustguard.consumer_id  -> consumer_id   (per-consumer policy, gate consumer.id)
    trustguard.user.id      -> attributes.user.id     (Activity "User" column)
    trustguard.user.email   -> attributes.user.email
    trustguard.session_id   -> session_id    (groups the turns of a conversation)
  Values come from the token Apigee has just verified, never from client-supplied headers.
  With VerifyAPIKey/OAuthV2 instead of JWT use developer.app.name / client_id / developer.email.
-->
<AssignMessage name="AM-TrustGuard-Context" continueOnError="false" enabled="true">
    <DisplayName>AM-TrustGuard-Context</DisplayName>
    <AssignVariable>
        <Name>trustguard.consumer_id</Name>
        <Template>{firstnonnull(jwt.VJ-VerifyAccessToken.claim.azp,jwt.VJ-VerifyAccessToken.claim.appid,jwt.VJ-VerifyAccessToken.claim.client_id)}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>trustguard.user.id</Name>
        <Template>{firstnonnull(jwt.VJ-VerifyAccessToken.claim.oid,jwt.VJ-VerifyAccessToken.claim.subject)}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>trustguard.user.email</Name>
        <Template>{firstnonnull(jwt.VJ-VerifyAccessToken.claim.email,jwt.VJ-VerifyAccessToken.claim.preferred_username,jwt.VJ-VerifyAccessToken.claim.upn)}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>trustguard.session_id</Name>
        <Ref>request.header.x-session-id</Ref>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
