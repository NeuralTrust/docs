<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Replace the caller's bearer token (verified above) with the provider key. -->
<AssignMessage name="AM-Provider-Auth" continueOnError="false" enabled="true">
    <DisplayName>AM-Provider-Auth</DisplayName>
    <AssignTo createNew="false" type="request"/>
    <Set>
        <Headers>
            <Header name="Authorization">Bearer {private.provider.api_key}</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
</AssignMessage>
