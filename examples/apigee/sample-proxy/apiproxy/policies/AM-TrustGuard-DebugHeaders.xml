<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Test aid: exposes the verdicts as response headers. Remove for production. -->
<AssignMessage name="AM-TrustGuard-DebugHeaders" continueOnError="true" enabled="true">
    <DisplayName>AM-TrustGuard-DebugHeaders</DisplayName>
    <AssignTo createNew="false" type="response"/>
    <Set>
        <Headers>
            <Header name="X-TrustGuard-Input">{trustguard.input.status}</Header>
            <Header name="X-TrustGuard-Input-Masked">{trustguard.input.masked}</Header>
            <Header name="X-TrustGuard-Output">{firstnonnull(trustguard.output.status,trustguard.output.unevaluated)}</Header>
            <Header name="X-TrustGuard-Output-Masked">{trustguard.output.masked}</Header>
            <Header name="X-TrustGuard-Failure">{trustguard.failure_reason}</Header>
            <Header name="X-TrustGuard-Trace-Id">{trustguard.input.trace_id}</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
