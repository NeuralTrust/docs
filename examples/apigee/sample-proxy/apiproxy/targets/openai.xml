<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="openai">
    <PreFlow name="PreFlow">
        <Request>
            <!-- Prompt check: last step before the provider. A block raises 403 and the provider is never called. -->
            <Step>
                <Name>FC-TrustGuard-Input</Name>
            </Step>
            <Step>
                <Name>KVM-Provider-GetKey</Name>
            </Step>
            <Step>
                <Name>AM-Provider-Auth</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <!-- Completion check: first step after the provider answers. -->
            <Step>
                <Name>FC-TrustGuard-Output</Name>
            </Step>
        </Response>
    </PostFlow>
    <Flows/>
    <HTTPTargetConnection>
        <!-- For a first end-to-end test, point this at an echo backend
             (https://mocktarget.apigee.net/echo) to see exactly what reaches the provider. -->
        <URL>https://api.openai.com</URL>
        <SSLInfo>
            <Enabled>true</Enabled>
            <Enforce>true</Enforce>
        </SSLInfo>
        <Properties>
            <Property name="io.timeout.millis">120000</Property>
        </Properties>
    </HTTPTargetConnection>
</TargetEndpoint>
