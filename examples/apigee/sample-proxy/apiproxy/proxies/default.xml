<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <!-- 1. Authenticate the caller first: the end user and app must be known before evaluation. -->
            <Step>
                <Name>VJ-VerifyAccessToken</Name>
            </Step>
            <!-- 2. Hand caller, end user and session to the shared flow. -->
            <Step>
                <Name>AM-TrustGuard-Context</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>AM-TrustGuard-DebugHeaders</Name>
            </Step>
        </Response>
    </PostFlow>
    <Flows/>
    <!-- The shared flow's RaiseFault policies (403 block, 503 unavailable, 400 stream) set the full
         error response themselves; no FaultRule is needed for them. Add FaultRules here only for
         your own policies (e.g. VerifyJWT failures). -->
    <FaultRules/>
    <HTTPProxyConnection>
        <BasePath>/llm/openai</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>openai</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
